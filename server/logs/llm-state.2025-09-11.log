	ToolExecutionResultMessage { id = "call_p6d7jqJatwvLQDeCoLwjPgkQ" toolName = "getRecipeById" text = "{
  "id" : "ed84e909-d9df-4ef7-8a9b-925577bacc6e",
  "title" : "Beef Tacos",
  "source" : "EVERNOTE",
  "author" : "Cook's Illustrated",
  "sourceUrl" : "https://www.cooksillustrated.com/recipes/180-beef-tacos?incode=MCSCD00L0&ref=new_search_experience_11",
  "yield" : "Makes 8 tacos, serving 4",
  "notes" : "This recipe emphasizes developing a boldly spiced beef mixture with fresh toppings. Techniques involve frying corn tortillas to make homemade taco shells and sautéing onions and garlic before adding spices to develop more flavor. Diners are encouraged to top their own tacos with various fillings, such as cheese, lettuce, and tomatoes, which are deemed essential. Tomato sauce should be from a can, not jarred pasta sauce.",
