	ToolExecutionResultMessage { id = "call_ZdpMJlTzheOLLLhkziipRIzt" toolName = "getRecipeById" text = "{
  "id" : "c3fafd5c-603d-44a2-b372-61b39e39bf44",
  "title" : "Garlic-Rosemary Roast Chicken with Jus",
  "source" : "EVERNOTE",
  "author" : "Cook's Illustrated",
  "sourceUrl" : "http://www.cooksillustrated.com/recipes/detail.asp?docid=6015#show%20more%20content",
  "yield" : "Serves 3 to 4",
  "notes" : "For the perfect garlic-rosemary roast chicken recipe, the chicken is brined in a saltwater solution flavored with garlic and rosemary. Then, a mixture of raw garlic, fresh rosemary, and olive oil is rubbed beneath the skin. This recipe includes techniques such as loosening the skin over breast and thigh, applying paste under the skin, and adjusting cooking methods to ensure even roasting. There is a step-by-step guide for applying the paste. Monitor the pan drippings to avoid burning; add water if necessary.",
  "ingredients" : [ {
    "ingredient" : "table salt",
    "amount" : "1/2",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "garlic, unpeeled",
    "amount" : "10",
    "unit" : "cloves",
    "note" : null
  }, {
    "ingredient" : "fresh rosemary",
    "amount" : "3",
    "unit" : "sprigs",
    "note" : null
  }, {
    "ingredient" : "whole chicken (about 4 pounds)",
    "amount" : "1",
    "unit" : null,
    "note" : "giblets discarded"
  }, {
    "ingredient" : "minced fresh rosemary",
    "amount" : "2",
    "unit" : "teaspoons",
    "note" : null
  }, {
    "ingredient" : "garlic, minced or pressed",
    "amount" : "2",
    "unit" : "medium cloves",
    "note" : "2 teaspoons"
  }, {
    "ingredient" : "table salt",
    "amount" : "1/8",
    "unit" : "teaspoon",
    "note" : null
  }, {
    "ingredient" : "Ground black pepper",
    "amount" : null,
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "extra-virgin olive oil",
    "amount" : "1",
    "unit" : "tablespoon",
    "note" : "plus extra for brushing chicken"
  }, {
    "ingredient" : "medium-large garlic, unpeeled",
    "amount" : "10",
    "unit" : "cloves",
    "note" : null
  }, {
    "ingredient" : "extra-virgin olive oil",
    "amount" : "1/2",
    "unit" : "teaspoon",
    "note" : null
  }, {
    "ingredient" : "low-sodium chicken broth",
    "amount" : "1 3/4",
    "unit" : "cups",
    "note" : null
  }, {
    "ingredient" : "water",
    "amount" : "1/2",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "dry white wine or vermouth",
    "amount" : "1/4",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "fresh rosemary",
    "amount" : "1",
    "unit" : "sprig",
    "note" : null
  }, {
    "ingredient" : "Salt and ground black pepper",
    "amount" : null,
    "unit" : null,
    "note" : null
  } ],
  "steps" : [ "FOR THE CHICKEN AND BRINE: Combine salt, garlic, and rosemary in a bag; seal and pound until garlic cloves are crushed. Transfer to a container with 2 cups hot tap water; let stand 10 minutes. Add 1 1/2 quarts cold tap water and stir until salt dissolves. Submerge chicken in brine and refrigerate for 1 hour.", "Remove chicken from brine and pat dry. Adjust oven rack to lower-middle position and preheat oven to 450°F. Set V-rack in a small roasting pan and spray with nonstick spray.", "FOR THE PASTE: Mix rosemary, garlic, salt, 1/4 teaspoon pepper, and 1 tablespoon oil. Rub about 1 1/2 teaspoons of paste in chicken cavity. Loosen skin and slip half of paste under skin on each breast side. Tie drumsticks and tuck wings. Rub chicken with 2 teaspoons oil and season with pepper.", "FOR THE JUS: While chicken is roasting, toss garlic cloves with 1/2 teaspoon oil; add to pan after 15 minutes. Continue roasting for another 15 minutes.", "Reduce oven temperature to 375°F. Flip chicken breast-side up and brush with 1 teaspoon oil. Add broth and water to pan and roast until golden brown and thermometer reads 160°F (breast) and 175°F (thigh), adding more water as necessary. Tilt V-rack to release juices into pan and transfer chicken to a plate.", "Remove garlic cloves; scrape browned bits in pan and pour liquid into a measuring cup. Let settle; peel and mash garlic. Skim fat, should have 2/3 cup liquid (add water if needed). Transfer to saucepan with wine, rosemary, remaining broth, and garlic paste. Simmer until reduced to 1 cup. Add chicken juices, discard rosemary, adjust seasoning, and serve with chicken." ],
