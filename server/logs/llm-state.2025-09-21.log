    "ingredient" : "celery ribs, chopped fine",
    "amount" : "3",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "lemon juice",
    "amount" : "2",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "minced fresh chives",
    "amount" : "1",
    "unit" : "tablespoon",
    "note" : null
