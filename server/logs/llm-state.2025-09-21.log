    "ingredient" : "baking powder",
    "amount" : "2",
    "unit" : "teaspoons",
    "note" : null
  }, {
    "ingredient" : "garlic powder",
    "amount" : "1 ½",
    "unit" : "teaspoons",
    "note" : null
  }, {
    "ingredient" : "cayenne pepper",
    "amount" : "¼",
    "unit" : "teaspoon",
