	ToolExecutionResultMessage { id = "call_EdGhE9ys2cQHiGxzDp3SuC9W" toolName = "chooseRandomRecipe" text = "{
  "id" : "f05ff858-7f92-4ea0-8368-2c2f8258709e",
  "title" : "Cheddar Soup",
  "source" : "EVERNOTE",
  "author" : "Cook's Illustrated",
  "sourceUrl" : "http://www.cooksillustrated.com/recipes/detail.asp?docid=4773",
  "yield" : "Makes about 7 cups, serving 4 to 6",
  "notes" : "For cheddar soup with deep flavor and velvety texture, sauté carrots, celery, and onion to create a flavor base. Use a roux (a mix of flour and butter) to thicken the soup and prevent it from separating, and combine chicken stock and half-and-half for richness. Add plenty of sharp cheddar cheese for a cheesy soup. Reheat in a saucepan over low heat, whisking gently to prevent separation. Do not bring above a bare simmer.",
  "ingredients" : [ {
    "ingredient" : "unsalted butter",
    "amount" : "3",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "medium onion",
    "amount" : "1",
    "unit" : null,
    "note" : "minced (about 1 cup)"
  }, {
    "ingredient" : "medium carrot",
    "amount" : "1",
    "unit" : null,
    "note" : "minced (about 1/3 cup)"
  }, {
    "ingredient" : "small rib celery",
    "amount" : "1",
    "unit" : null,
    "note" : "minced (about 1/4 cup)"
  }, {
    "ingredient" : "medium clove garlic",
    "amount" : "1",
    "unit" : null,
    "note" : "minced"
  }, {
    "ingredient" : "unbleached all-purpose flour",
    "amount" : "2",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "low-sodium chicken broth",
    "amount" : "2 1/2",
    "unit" : "cups",
    "note" : null
  }, {
    "ingredient" : "half-and-half",
    "amount" : "2 1/2",
    "unit" : "cups",
    "note" : null
  }, {
    "ingredient" : "bay leaf",
    "amount" : "1",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "cayenne pepper",
    "amount" : "pinch",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "dry sherry",
    "amount" : "3",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "sharp cheddar cheese",
    "amount" : "12",
    "unit" : "ounces",
    "note" : "shredded (about 3 cups)"
  }, {
    "ingredient" : "minced fresh thyme leaves",
    "amount" : "1",
    "unit" : "tablespoon",
    "note" : null
  }, {
    "ingredient" : "Salt and ground black pepper",
    "amount" : null,
    "unit" : null,
    "note" : null
  } ],
  "steps" : [ "Heat butter in large heavy-bottomed Dutch oven over medium heat until foaming. Add onion and cook, stirring occasionally, until softened, about 4 minutes.", "Add carrot, celery, and garlic; cook until garlic is fragrant, about 1 minute. Add flour and cook, stirring to coat vegetables, until mixture begins to brown on bottom of pot, about 2 minutes.", "Gradually whisk in chicken broth and half-and-half and add bay leaf. Increase heat to medium-high and bring to boil; reduce heat to medium-low and simmer until vegetables soften, about 10 minutes.", "Off heat, add cayenne and sherry; cool soup for 1 minute. Slowly whisk in cheese and thyme; season with salt and pepper and serve immediately." ],
