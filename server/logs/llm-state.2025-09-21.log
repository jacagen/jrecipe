	ToolExecutionResultMessage { id = "call_EGecSkEYuzCvbgXWGnH9dMNA" toolName = "chooseRandomRecipe" text = "{
  "id" : "d585e889-61c0-4f0e-b669-083ae4ab1b0f",
  "title" : "Duck Fat-Roasted Potatoes",
  "source" : "EVERNOTE",
  "author" : "Cook's Illustrated",
  "sourceUrl" : "http://www.cooksillustrated.com/recipes/8342-duck-fat-roasted-potatoes%20?j=370&e=jamiegentry@yahoo.com&l=26_HTML&u=48224&mid=7211371&jb=192&extcode=LQ15E2QAA&sourcekey=CQ15052AA&cds_response_key=IEQ15EBAM&cds_tracking_code=&tag=cionewsletter-20&atc=cionews",
  "yield" : "Serves 6",
  "notes" : "Duck fat provides unmatched flavor and richness. Techniques include roasting potatoes on a sheet pan on the top shelf of a hot oven for even cooking and boiling briefly in a baking soda bath to degrade pectin and create a crispy shell. An easy scrape-and-toss approach is used to coat potatoes with a starchy paste. Duck fat can be substituted with chicken fat, lard, or a mixture of bacon fat and extra-virgin olive oil. Saving leftover fat from bacon, roasts, or poultry is recommended for future cooking uses. Store in a Mason jar in the refrigerator for up to one month or freeze for up to six months.",
  "ingredients" : [ {
    "ingredient" : "Yukon Gold potatoes",
    "amount" : "3 ½",
    "unit" : "pounds",
    "note" : "peeled and cut into 1 ½-inch pieces"
  }, {
    "ingredient" : "Kosher salt and pepper",
    "amount" : null,
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "baking soda",
    "amount" : "½",
    "unit" : "teaspoon",
    "note" : null
  }, {
    "ingredient" : "duck fat",
    "amount" : "6",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "chopped fresh rosemary",
    "amount" : "1",
    "unit" : "tablespoon",
    "note" : null
  } ],
  "steps" : [ "Adjust oven rack to top position, place rimmed baking sheet on rack, and heat oven to 475 degrees.", "Bring 10 cups water to boil in Dutch oven over high heat. Add potatoes, 1/3 cup salt, and baking soda. Return to boil and cook for 1 minute. Drain potatoes. Return potatoes to pot and place over low heat. Cook, shaking pot occasionally, until surface moisture has evaporated, about 2 minutes. Remove from heat. Add 5 tablespoons fat and 1 teaspoon salt; mix with rubber spatula until potatoes are coated with thick paste, about 30 seconds.", "Remove sheet from oven, transfer potatoes to sheet, and spread into even layer. Roast for 15 minutes.", "Remove sheet from oven. Using thin, sharp, metal spatula, turn potatoes. Roast until golden brown, 12 to 15 minutes. While potatoes roast, combine rosemary and remaining 1 tablespoon fat in bowl.", "Remove sheet from oven. Spoon rosemary-fat mixture over potatoes and turn again. Continue to roast until potatoes are well browned and rosemary is fragrant, 3 to 5 minutes. Season with salt and pepper to taste. Serve immediately." ],
