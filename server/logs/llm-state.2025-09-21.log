	ToolExecutionResultMessage { id = "call_F7tim7mLDkvRdAS3rAhGRQoy" toolName = "chooseRandomRecipe" text = "{
  "id" : "55e3606f-8d95-4322-8be8-4f0c3fdcde9f",
  "title" : "Pastrami Cheeseburgers",
  "source" : "EVERNOTE",
  "author" : null,
  "sourceUrl" : "https://www.cookscountry.com/recipes/8761-pastrami-cheeseburgers",
  "yield" : "Serves 4",
  "notes" : "Sauerkraut, pastrami, Swiss cheese, and a tangy sauce transform an ordinary burger into something special. Our favorite sauerkraut is Eden Organic Sauerkraut.",
  "ingredients" : [ {
    "ingredient" : "mayonnaise",
    "amount" : "6",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "ketchup",
    "amount" : "3",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "sweet pickle relish",
    "amount" : "2",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "Salt and pepper",
    "amount" : null,
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "kaiser rolls, split and toasted",
    "amount" : "4",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "85 percent lean ground beef",
    "amount" : "1",
    "unit" : "pound",
    "note" : null
  }, {
    "ingredient" : "vegetable oil",
    "amount" : "1",
    "unit" : "tablespoon",
    "note" : null
  }, {
    "ingredient" : "thinly sliced deli pastrami",
    "amount" : "6",
    "unit" : "ounces",
    "note" : null
  }, {
    "ingredient" : "sauerkraut, drained and pressed dry",
    "amount" : "1 1/2",
    "unit" : "cups",
    "note" : null
  }, {
    "ingredient" : "deli Swiss cheese, folded in half",
    "amount" : "8",
    "unit" : "slices",
    "note" : null
  } ],
  "steps" : [ "Whisk mayonnaise, ketchup, relish, and ½ teaspoon pepper together in a bowl. Spread sauce evenly on roll tops and bottoms; set aside. Gently shape beef into four 4-inch-diameter patties. Season each patty with salt and pepper.", "Heat oil in a 12-inch skillet over medium-high heat until just smoking. Add patties to skillet and cook without moving for 2 minutes. Flip patties and cook for 1 minute. Transfer burgers to a plate and tent with foil.", "Add pastrami to the now-empty skillet and cook over medium-high heat until lightly browned, about 3 minutes. Stir in sauerkraut and cook until heated through, about 2 minutes. Remove skillet from heat; separate pastrami mixture into 4 portions (still in skillet), then top each portion with 2 slices of cheese. Cover and let sit until cheese melts, about 2 minutes. Transfer burgers to roll bottoms. Top each burger with 1 portion of pastrami mixture. Place roll tops on burgers. Serve." ],
