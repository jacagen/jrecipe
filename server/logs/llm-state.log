	UserMessage { name = null contents = [TextContent { text = "Please show me a random recipe." }] }
	AiMessage { text = null, thinking = null, toolExecutionRequests = [ToolExecutionRequest { id = "call_hoEZRm3C5FFWm5H4rkz4KzCa", name = "chooseRandomRecipe", arguments = "{}" }], attributes = {} }
	ToolExecutionResultMessage { id = "call_hoEZRm3C5FFWm5H4rkz4KzCa" toolName = "chooseRandomRecipe" text = "{
  "id" : "9dc76007-12bf-46cf-9c19-d26b8d963d27",
  "title" : "Crisp Breaded Chicken Cutlets",
  "source" : "EVERNOTE",
  "author" : "Cook's Illustrated",
  "sourceUrl" : "http://www.cooksillustrated.com/recipes/detail.asp?docid=5065",
  "yield" : "Serves 4",
  "notes" : "Published September 1, 2001. To ensure even cooking, flatten the chicken breasts to 1/4 inch and brine. Use panko for extra crispness if preferred. Cook in batches of two for a crisper crust. Remove tenderloins at the outset, though they can be breaded and fried separately. Serve cutlets with lemon wedges or use in sandwiches.",
  "ingredients" : [ {
    "ingredient" : "boneless, skinless chicken breasts",
    "amount" : "4",
    "unit" : null,
    "note" : "(6 to 8 ounces each), tenderloins removed"
  }, {
    "ingredient" : "kosher salt",
    "amount" : "1/2",
    "unit" : "cup",
    "note" : "or 1/4 cup table salt"
  }, {
    "ingredient" : "granulated sugar",
    "amount" : "1/2",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "high-quality white bread",
    "amount" : "5 - 8",
    "unit" : "slices",
    "note" : "crusts removed and torn into rough 1 1/2-inch pieces"
  }, {
    "ingredient" : "Ground black pepper",
    "amount" : null,
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "unbleached all-purpose flour",
    "amount" : "3/4",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "large eggs",
    "amount" : "2",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "vegetable oil",
    "amount" : "1",
    "unit" : "tablespoon",
    "note" : null
  }, {
    "ingredient" : "vegetable oil",
    "amount" : "3/4",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "Lemon wedges",
    "amount" : null,
    "unit" : null,
    "note" : "for serving"
  } ],
  "steps" : [ "Pound chicken breasts to an even 1/2-inch thickness. Dissolve salt and sugar in 1 quart cold water in a gallon-sized zipper-lock plastic bag. Add cutlets and seal the bag, pressing out as much air as possible; refrigerate for 30 minutes. Line a rimmed baking sheet with a triple layer of paper towels.", "Remove cutlets and lay them in a single layer on the baking sheet; cover with another triple layer of paper towels and press firmly to absorb moisture. Allow cutlets to dry for 10 minutes. Process bread in a food processor until evenly fine-textured, 20 to 30 seconds (you should have about 1 1/2 cups fresh bread crumbs). Transfer crumbs to a baking dish. Carefully peel paper towels off cutlets, sprinkle cutlets with pepper, and set aside.", "Adjust oven rack to lower-middle position, set a large heatproof plate on the rack, and heat oven to 200 degrees. Spread flour in a baking dish. Beat eggs with 1 tablespoon of oil in a second baking dish. Spread bread crumbs in a third baking dish.", "Bread the cutlets, one at a time. Dredge cutlet in flour, shaking off excess. Using tongs, dip both sides of cutlet in egg mixture, allowing excess to drip back into the baking dish to ensure a very thin coating. Dip both sides of cutlet in bread crumbs, pressing crumbs with fingers to form an even, cohesive coat. Place breaded cutlets in a single layer on a wire rack set over a baking sheet and allow coating to dry for about 5 minutes.", "Meanwhile, heat 6 tablespoons of the remaining oil in a heavy-bottomed 10-inch nonstick skillet over medium-high heat until shimmering but not smoking, about 2 minutes. Lay two cutlets gently in the skillet; cook until deep golden brown and crisp on the first side, gently pressing down on cutlets with a wide metal spatula to help ensure even browning, about 2 1/2 minutes. Using tongs, flip cutlets, reduce heat to medium, and continue to cook until meat feels firm when pressed gently and the second side is deep golden brown and crisp, 2 1/2 to 3 minutes longer. Line a warmed plate with a double layer of paper towels and set cutlets on top; return plate to oven.", "Discard oil in skillet and wipe skillet clean using tongs and a large wad of paper towels. Repeat the cooking process for the remaining cutlets using the remaining 6 tablespoons of oil. Serve with lemon wedges." ],
  "createdInSource" : {
    "epochSeconds" : 978302296,
    "nanosecondsOfSecond" : 0
  },
  "updatedInSource" : {
    "epochSeconds" : 1412453302,
    "nanosecondsOfSecond" : 0
