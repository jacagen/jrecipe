	ToolExecutionResultMessage { id = "call_lBBD74rbuK2F9fEbhxUM3aa9" toolName = "chooseRandomRecipe" text = "{
  "id" : "21d79c40-0bba-420b-aa5f-92c36e7faaf3",
  "title" : "Creamy Baked Four-Cheese Pasta",
  "source" : "EVERNOTE",
  "author" : "Cook's Illustrated",
  "sourceUrl" : "http://www.cooksillustrated.com/recipes/detail.asp?docid=4640",
  "yield" : "Serves 4-6 as main course, 6-8 as a side",
  "notes" : "Published January 1, 2003. Techniques include pulsing bread in food processor for breadcrumb topping, cooking pasta until very al dente, and combining hot cream with cheeses to melt. Variations include Baked Four-Cheese Pasta with Prosciutto and Peas, and with Tomatoes and Basil. Equipment reviews and taste tests available on original site.",
  "ingredients" : [ {
    "ingredient" : "white sandwich bread",
    "amount" : "3–4",
    "unit" : "slices",
    "note" : "with crusts, torn into quarters"
