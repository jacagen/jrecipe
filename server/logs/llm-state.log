	ToolExecutionResultMessage { id = "call_aeVtQpcyHfXisUc6f6kMnrNx" toolName = "chooseRandomRecipe" text = "{
  "id" : "99c05383-9068-4bd6-9b8a-3d52732a8e84",
  "title" : "Hot Chicken Salad - Cook's Country",
  "source" : "EVERNOTE",
  "author" : null,
  "sourceUrl" : "https://www.cookscountry.com/recipes/8752-hot-chicken-salad",
  "yield" : "Serves 6 to 8",
  "notes" : "This retro chicken \"salad\" is a homey casserole. It combines sour cream and mayonnaise for the base, with cheddar and Gruyere providing a rich, nutty flavor. Red onion and celery add a “salad” touch, and it's seasoned with lemon juice, chives, cayenne pepper, and topped with a crispy potato chip crust. The casserole should cool for 10 minutes before serving.",
  "ingredients" : [ {
    "ingredient" : "sour cream",
    "amount" : "1",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "mayonnaise",
    "amount" : "1",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "slivered almonds, toasted and chopped coarse",
    "amount" : "1",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "sharp cheddar cheese, shredded",
    "amount" : "4",
    "unit" : "ounces",
    "note" : "1 cup"
  }, {
    "ingredient" : "Gruyère cheese, shredded",
    "amount" : "4",
    "unit" : "ounces",
    "note" : "1 cup"
  }, {
    "ingredient" : "small red onion, chopped fine",
    "amount" : "1",
    "unit" : null,
