	ToolExecutionResultMessage { id = "call_0ynqURfNSMswUFXKUvNzYld1" toolName = "chooseRandomRecipe" text = "{
  "id" : "67ffd05b-47ab-4fd1-8413-c2ed556217b8",
  "title" : "Pan-Seared, Oven-Roasted Thick-Cut Pork Chops",
  "source" : "EVERNOTE",
  "author" : null,
  "sourceUrl" : "http://www.cooksillustrated.com/recipes/detail.asp?docid=6106",
  "yield" : "Serves 4",
  "notes" : "This recipe is designed to accommodate the leaner nature of modern pork, employing a brine to enhance flavor and moisture. The chops are first brined, then pan-seared to get a good crust, and finally finished by roasting in the oven. The resting period after cooking lets the juices redistribute through the meat.\n\nIf making one of the suggested pan sauces, only use water, sugar, and salt in the brine and omit other flavorings. The sauce should be prepared while the chops are in the oven. For best results, after brining, leave the chops uncovered in the refrigerator to air dry for up to 3 hours.\n\nTechnique highlights: Ensure chops are well-browned on both sides without crowding in the pan. Transfer immediately to a preheated pan in the oven after searing.",
  "ingredients" : [ {
    "ingredient" : "dark brown sugar (lightly packed)",
    "amount" : "3/4",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "kosher salt (or 1/4 cup table salt)",
    "amount" : "1/2",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "medium cloves garlic, crushed",
    "amount" : "10",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "bay leaves, crumbled",
    "amount" : "4",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "whole cloves",
    "amount" : "8",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "whole black peppercorns, crushed",
    "amount" : "3",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "bone-in rib loin pork chops (12-ounces each), 1 1/2-inches-thick",
    "amount" : "4",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "vegetable oil",
    "amount" : "2",
    "unit" : "tablespoons",
    "note" : null
  } ],
  "steps" : [ "In gallon-sized zipper-lock plastic bag, dissolve sugar and salt in 2 cups hot water. Add garlic, bay leaves, cloves, peppercorns, and 4 cups cold water; cool mixture to room temperature. Add pork chops, then seal bag, pressing out as much air as possible; refrigerate until fully seasoned, about 1 hour, turning bag once. Remove chops from brine and dry thoroughly with paper towels.", "Adjust oven rack to lower-middle position, place shallow roasting pan or jelly-roll pan on oven rack, and heat oven to 450 degrees. When oven reaches 450 degrees, heat oil in 12-inch heavy-bottomed skillet over high heat until shimmering but not smoking, about 2 minutes. Place chops in skillet; cook until well-browned and nice crust has formed on surface, about 2 minutes. Turn chops over with tongs; cook until well-browned and a nice crust has formed on second side, about 2 minutes longer. Using tongs, transfer chops to preheated pan in oven. Roast until instant-read thermometer inserted into the center of each chop registers 125–127 degrees, 8 to 10 minutes, turning chops over once halfway through cooking time. Transfer each chop to platter; cover loosely with foil (be sure not to wrap foil tightly around meat), and let rest about 5 minutes. (Check internal temperature; it should register about 145 degrees)." ],
