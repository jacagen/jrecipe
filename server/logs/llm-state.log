	ToolExecutionResultMessage { id = "call_aeVtQpcyHfXisUc6f6kMnrNx" toolName = "chooseRandomRecipe" text = "{
  "id" : "99c05383-9068-4bd6-9b8a-3d52732a8e84",
  "title" : "Hot Chicken Salad - Cook's Country",
  "source" : "EVERNOTE",
  "author" : null,
  "sourceUrl" : "https://www.cookscountry.com/recipes/8752-hot-chicken-salad",
  "yield" : "Serves 6 to 8",
  "notes" : "This retro chicken \"salad\" is a homey casserole. It combines sour cream and mayonnaise for the base, with cheddar and Gruyere providing a rich, nutty flavor. Red onion and celery add a “salad” touch, and it's seasoned with lemon juice, chives, cayenne pepper, and topped with a crispy potato chip crust. The casserole should cool for 10 minutes before serving.",
  "ingredients" : [ {
    "ingredient" : "sour cream",
    "amount" : "1",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "mayonnaise",
    "amount" : "1",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "slivered almonds, toasted and chopped coarse",
    "amount" : "1",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "sharp cheddar cheese, shredded",
    "amount" : "4",
    "unit" : "ounces",
    "note" : "1 cup"
  }, {
    "ingredient" : "Gruyère cheese, shredded",
    "amount" : "4",
    "unit" : "ounces",
    "note" : "1 cup"
  }, {
    "ingredient" : "small red onion, chopped fine",
    "amount" : "1",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "celery ribs, chopped fine",
    "amount" : "3",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "lemon juice",
    "amount" : "2",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "minced fresh chives",
    "amount" : "1",
    "unit" : "tablespoon",
    "note" : null
  }, {
    "ingredient" : "salt",
    "amount" : "1",
    "unit" : "teaspoon",
    "note" : null
  }, {
    "ingredient" : "cayenne pepper",
    "amount" : "1/4",
    "unit" : "teaspoon",
    "note" : null
  }, {
    "ingredient" : "cooked boneless, skinless chicken breast, cut into ½-inch pieces",
    "amount" : "2 1/2",
    "unit" : "pounds",
    "note" : "6 cups"
  }, {
    "ingredient" : "potato chips",
    "amount" : "8",
    "unit" : "ounces",
    "note" : null
  }, {
    "ingredient" : "paprika",
    "amount" : "1",
    "unit" : "teaspoon",
    "note" : null
  } ],
  "steps" : [ "Adjust oven rack to middle position and heat oven to 325 degrees. Grease a 13 by 9-inch baking dish. Combine sour cream, mayonnaise, almonds, cheddar, Gruyère, onion, celery, lemon juice, chives, salt, and cayenne in a large bowl. Fold in chicken until thoroughly combined. Transfer mixture to prepared dish and spread in an even layer.", "Place potato chips and paprika in a large zipper-lock bag, press to remove air, and seal. Using a rolling pin, crush chips to fine crumbs. Sprinkle chip mixture evenly over casserole. Bake until casserole is bubbling and chips begin to brown, 40 to 45 minutes. Let cool for 10 minutes and serve." ],
