    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "slivered almonds, toasted and chopped coarse",
    "amount" : "1",
    "unit" : "cup",
    "note" : null
  }, {
    "ingredient" : "sharp cheddar cheese, shredded",
    "amount" : "4",
    "unit" : "ounces",
    "note" : "1 cup"
  }, {
    "ingredient" : "Gruyère cheese, shredded",
    "amount" : "4",
    "unit" : "ounces",
    "note" : "1 cup"
  }, {
    "ingredient" : "small red onion, chopped fine",
    "amount" : "1",
