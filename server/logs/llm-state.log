	ToolExecutionResultMessage { id = "call_DS8bMw72wspk1dAaM0iZcozQ" toolName = "chooseRandomRecipe" text = "{
  "id" : "7ca4bd14-4a8f-41a9-812e-d93dfb47ea05",
  "title" : "Smothered Pork Chops",
  "source" : "EVERNOTE",
  "author" : "Cook's Illustrated",
  "sourceUrl" : "http://www.cooksillustrated.com/recipes/detail.asp?docid=5027",
  "yield" : "Serves 4",
  "notes" : "To perfect the smothered pork chop recipe, it uses bone-in, rib-end pork chops for their juiciness and flavor. Thin chops absorb more gravy flavor. The best method is searing in bacon fat and braising for 30 minutes in a bacon fat onion gravy, providing a sweet, salty, smoky flavor. Make sure to use low-sodium chicken broth in this recipe to avoid an over-seasoned sauce. Serve with egg noodles, rice, or mashed potatoes.",
  "ingredients" : [ {
    "ingredient" : "bacon",
    "amount" : "3",
    "unit" : "ounces",
    "note" : "about 3 slices, cut into 1/4-inch pieces"
  }, {
    "ingredient" : "unbleached all-purpose flour",
    "amount" : "2",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "low-sodium chicken broth",
    "amount" : "1 3/4",
    "unit" : "cups",
    "note" : null
  }, {
    "ingredient" : "vegetable oil",
    "amount" : null,
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "bone-in, rib-end pork chops",
    "amount" : "4",
    "unit" : null,
    "note" : "1/2 to 3/4 inch thick"
  }, {
    "ingredient" : "ground black pepper",
    "amount" : null,
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "medium yellow onions",
    "amount" : "2",
    "unit" : null,
    "note" : "halved pole-to-pole and sliced thin"
  }, {
    "ingredient" : "table salt",
    "amount" : null,
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "water",
    "amount" : "2",
    "unit" : "tablespoons",
    "note" : null
  }, {
    "ingredient" : "garlic",
    "amount" : "2",
    "unit" : "medium cloves",
    "note" : "pressed through garlic press or minced"
  }, {
    "ingredient" : "fresh thyme leaves",
    "amount" : "1",
    "unit" : "teaspoon",
    "note" : "minced"
  }, {
    "ingredient" : "bay leaves",
    "amount" : "2",
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "fresh parsley leaves",
    "amount" : "1",
    "unit" : "tablespoon",
    "note" : "minced"
  } ],
  "steps" : [ "Fry bacon in a small saucepan over medium heat until lightly browned. Transfer bacon to paper towel-lined plate, leaving fat in saucepan. Gradually whisk flour into fat until smooth and cook until light brown. Whisk in chicken broth; increase heat and bring to boil. Set aside off heat.", "Heat 1 tablespoon oil in a skillet over high heat until smoking. Season pork chops with pepper, brown on both sides, and transfer to a plate.", "Reduce heat to medium and add oil, onions, salt, and water to skillet. Scrape browned bits and cook until onions are softened. Stir in garlic and thyme and cook until fragrant. Return chops to skillet, cover with onions. Add warm sauce, bay leaves, cover, and simmer until pork is tender.", "Transfer chops to a platter. Increase heat and simmer sauce until thickened. Discard bay leaves, stir in parsley, and adjust seasoning. Cover chops with sauce, sprinkle with reserved bacon, and serve immediately." ],
