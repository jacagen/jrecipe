    "ingredient" : "hearty white sandwich bread",
    "amount" : "2",
    "unit" : "slices",
    "note" : "torn into pieces"
  }, {
    "ingredient" : "grated Pecorino Romano",
    "amount" : "1 1/4",
    "unit" : "cups",
    "note" : "see note"
  }, {
    "ingredient" : "Salt and pepper",
    "amount" : null,
    "unit" : null,
    "note" : null
  }, {
    "ingredient" : "large eggs",
    "amount" : "2",
